{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "satellite-visualization",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "orbitgaze.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "SATELLITE_DATA", "id": "3814f27795394f969f4e2ac51a86d109" }
  ],
  "triggers": { "crons": ["17 */2 * * *"] },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
